# Copy to backend/.env for local development. Do not commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=frekcore
SECRET_KEY=replace-with-a-strong-random-secret
CORS_ORIGINS=http://localhost:3000
FREK_ENV=development
FREK_CLIENT_KILTIKONET_SECRET=replace-with-a-unique-client-secret
FREK_CLIENT_CVLBRAIN_SECRET=replace-with-a-unique-client-secret
# Configure Staff PINs explicitly before enabling Staff accounts.
FREK_STAFF_SUPERVISEUR_PIN=
FREK_STAFF_EMISSION_PIN=
FREK_STAFF_ACCES_PIN=
FREK_STAFF_CASHLESS_PIN=
