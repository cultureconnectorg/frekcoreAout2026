# Copy to backend/.env for local development. Do not commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=frekcore
SECRET_KEY=replace-with-a-strong-random-secret
# Required by frek_v1/utils.py:hash_email() (badges/create, identity/emit,
# and anything else that hashes an email address). Was missing from this
# file until Phase 3 (reports/16_INTEGRATION_TEST_BASELINE.md) — its
# absence produced real 500s ("Variable d'environnement manquante:
# FREK_EMAIL_SALT") on every route that hashes an email, reproduced via a
# fresh environment built strictly from this file.
FREK_EMAIL_SALT=replace-with-a-strong-random-salt
CORS_ORIGINS=http://localhost:3000
FREK_ENV=development
FREK_CLIENT_KILTIKONET_SECRET=replace-with-a-unique-client-secret
FREK_CLIENT_CVLBRAIN_SECRET=replace-with-a-unique-client-secret
# Configure Staff PINs explicitly before enabling Staff accounts.
FREK_STAFF_SUPERVISEUR_PIN=
FREK_STAFF_EMISSION_PIN=
FREK_STAFF_ACCES_PIN=
FREK_STAFF_CASHLESS_PIN=
